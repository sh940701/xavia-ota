# fitters-log production variables (placeholders only; real values live in GCP Secret Manager)
BLOB_STORAGE_TYPE=gcs
GCP_BUCKET_NAME=your-ota-assets-bucket
DB_TYPE=supabase
HOST=https://ota.example.com
NODE_ENV=production
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=change-me
UPLOAD_KEY=change-me
PRIVATE_KEY_BASE_64=base64-encoded-code-signing-private-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_API_KEY=your-supabase-service-key

# Local development (copy to .env.local and replace the block above)
# DB_TYPE=postgres
# BLOB_STORAGE_TYPE=local
# HOST=http://localhost:3001
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=releases_db
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
